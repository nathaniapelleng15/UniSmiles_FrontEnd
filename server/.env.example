# Copy file ini jadi .env dan isi sesuai konfigurasi

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=unismile_db
DB_SSL=false # Set to true if deploying to cloud database like Aiven

PORT=3001
# URL publik backend untuk link email, QR, dan foto.
# Local: http://localhost:3001
# Hosting: isi dengan URL publik backend dari provider yang digunakan.
# Jangan tambahkan /download di akhir URL.
PUBLIC_BASE_URL=http://localhost:3001
# BASE_URL tetap didukung untuk deployment lama.
BASE_URL=http://localhost:3001

# Email Provider: smtp (Gmail SMTP, App Password), gmail-api (Gmail API via OAuth2), resend (Resend API)
EMAIL_PROVIDER=smtp

# SMTP Gmail (App Password, bukan password biasa) - untuk EMAIL_PROVIDER=smtp
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Nama lama tetap didukung untuk deployment yang sudah ada
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_app_password_here

# Gmail API (OAuth2) - untuk EMAIL_PROVIDER=gmail-api
# Buat OAuth2 credentials di https://console.cloud.google.com lalu dapatkan refresh token
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token

# Resend API - untuk EMAIL_PROVIDER=resend
# Dapatkan API key di https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# API Key kiosk (isi sama dengan VITE_KIOSK_API_KEY di frontend .env)
KIOSK_API_KEY=

# CORS (isi domain frontend, gunakan * untuk dev)
ALLOWED_ORIGIN=*
