# Nilai untuk BUILD PRODUKSI photobooth saja.
#
# KENAPA BERKAS INI ADA
#
# Sebelumnya nilai-nilai ini diberikan lewat baris perintah saat membangun, dan
# itu tidak tercatat di mana pun. Akibatnya build produksi memakai
# VITE_ENABLE_LOCAL_KIOSK_BRIDGE=true, sehingga setiap kali halaman dimuat ia
# menembak ws://localhost:3011 dan GET http://localhost:3011/api/kiosk-status —
# padahal kiosk-agent tidak dijalankan di PC kiosk ini (printer label
# dijangkau langsung lewat Web Bluetooth). Yang muncul di konsol:
#
#   GET http://localhost:3011/api/kiosk-status net::ERR_CONNECTION_REFUSED
#
# Bridge MATI karena tidak dipakai. Kalau suatu saat agent dijalankan, ubah ke
# true DI SINI — bukan di baris perintah — supaya tercatat dan ikut ter-deploy.

# Harus memuat prefiks API.
VITE_API_BASE_URL=https://api.uniinside.net/api/v1

# Bridge ke kiosk-agent lokal. TIDAK dipakai: printer label dijangkau langsung
# lewat Web Bluetooth, dan setelan cetak diambil lewat HTTP dari backend.
VITE_ENABLE_LOCAL_KIOSK_BRIDGE=false
